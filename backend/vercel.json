{
  "rewrites": [
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/api/health", "destination": "/api/index.py" },
    { "source": "/api/status", "destination": "/api/index.py" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/setup/:path*", "destination": "/api/index.py" },
    { "source": "/devices/:path*", "destination": "/api/index.py" },
    { "source": "/bins/:path*", "destination": "/api/index.py" },
    { "source": "/workers/:path*", "destination": "/api/index.py" },
    { "source": "/admins/:path*", "destination": "/api/index.py" },
    { "source": "/zones/:path*", "destination": "/api/index.py" },
    { "source": "/alerts/:path*", "destination": "/api/index.py" },
    { "source": "/reports/:path*", "destination": "/api/index.py" },
    { "source": "/config", "destination": "/api/index.py" },
    { "source": "/contact-admin", "destination": "/api/index.py" },
    { "source": "/users/:path*", "destination": "/api/index.py" },
    { "source": "/images/:path*", "destination": "/api/index.py" },
    { "source": "/upload/:path*", "destination": "/api/index.py" },
    { "source": "/analytics/:path*", "destination": "/api/index.py" },
    { "source": "/tasks/:path*", "destination": "/api/index.py" },
    { "source": "/notifications/:path*", "destination": "/api/index.py" },
    { "source": "/((?!api|setup|devices|bins|workers|admins|zones|alerts|reports|config|contact-admin|users|images|upload|analytics|tasks|notifications|health|.*\\..*).*)", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
